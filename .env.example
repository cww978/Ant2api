# Server Port & Host
PORT=8080
HOST=0.0.0.0

# Admin Web Dashboard Password
ADMIN_PASSWORD=ant2api_admin
JWT_SECRET=ant2api-jwt-custom-secret-key

# Persistent Data Storage Directory
DATA_DIR=./data

# Default Model Fallback
DEFAULT_MODEL=gemini-2.5-pro

# Request Timeout (Milliseconds)
REQUEST_TIMEOUT_MS=120000

# Optional Outbound Proxy (HTTP/HTTPS/SOCKS5)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Optional Google OAuth Default Client ID / Secret Override
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Debug Logs
DEBUG=false
